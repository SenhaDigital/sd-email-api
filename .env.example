# Configurações do ambiente Serverless
STAGE=dev
REGION=us-east-1
ACCOUNT_ID=
PROFILE=dev

# Email do remetente
DEFAULT_FROM_EMAIL=no-reply@seudominio.com

# Configurações SMTP Zoho (descentralizado, independente de AWS)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=seu-usuario@seudominio.com.br
SMTP_PASS=sua-senha-de-aplicativo-zoho
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=true

# Configurações do MongoDB
DATABASE_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/nome-do-banco?retryWrites=true&w=majority
DATABASE_NAME=SDC
EMAIL_COLLECTION=emails

# Definido automaticamente pelo Serverless Framework após o deploy
EMAIL_QUEUE_URL=
SEND_EMAIL_QUEUE_URL=
# AWS_REGION=us-east-1
