{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": ".build",
    "rootDir": "./",
    "strict": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "lib": ["es2022"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules/**/*",
    ".build/**/*"
  ]
}
